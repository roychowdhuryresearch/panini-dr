# Secrets: copy .env.example to .env and fill it in; never commit .env.
.env
.env.*
!.env.example

# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data, indexes, caches and run outputs (see datasets/README.md). Benchmark
# questions, corpora, dense caches, judge caches and traces never belong in git.
/data/
data/
runs/
outputs/
logs/
*.log
retrieval_cache/
dense_cache/
judge_cache*/
*_cache.json
*.npy
*.faiss
*.index
*.pkl
*.parquet

# Third-party checkouts fetched by setup scripts
third_party/

# Default output locations used in README.md, REPRODUCE.md and docs/: judge
# caches and verdicts (they contain gold answers) and the downloaded verify
# bundle (its traces contain the eight FRAMES questions and answers).
judge/
panini-dr-verify/
