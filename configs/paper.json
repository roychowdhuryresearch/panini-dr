{
  "_about": "The PANINI-DR paper configuration, fully resolved. 'config' is exactly the adapter config recorded in cell_result.json by the paper runs (BrowseComp-Plus CF-150, FRAMES-824, MoNaCo-1315), minus the dataset keys listed in 'dataset_keys'. `panini-dr run` expands the preset (configs/presets/champion_82.json + the agentic overlay + the paper's command-line values, see panini_dr/config.py) and refuses to start if the result differs from 'config' unless --allow-config-drift is given. 'pinned_adapter_defaults' are values that are not config keys but govern the run; they are checked against the constructed adapter.",
  "system": "ours_gsw_planner_orchestrator_v1",
  "model": "openai/gpt-oss-120b",
  "split": "full",
  "concurrency": 32,
  "config": {
    "gsw_agentic_read": true,
    "gsw_blank_hints": true,
    "gsw_blank_qualifier": true,
    "gsw_blank_verifier": true,
    "gsw_blank_verifier_mode": "enforce",
    "gsw_block_unverified_cascade": false,
    "gsw_candidate_evidence_matrix": false,
    "gsw_champion": true,
    "gsw_codegen_compute": true,
    "gsw_codegen_frozen": true,
    "gsw_context_compaction": true,
    "gsw_edge_grounded": true,
    "gsw_edge_grounded_cap": 5,
    "gsw_evidence_gate": "measure",
    "gsw_evidence_grounder": "llm",
    "gsw_evidence_state": true,
    "gsw_grounding_holistic_fallback": false,
    "gsw_grounding_strict_tries": 2,
    "gsw_hard_type_filter": true,
    "gsw_investigation_memory": true,
    "gsw_investigation_memory_enforce": true,
    "gsw_investigation_memory_finalshot": true,
    "gsw_max_plan_updates": 5,
    "gsw_memory_dossier": true,
    "gsw_memory_scoped_dispatch": true,
    "gsw_orchestrator_live": true,
    "gsw_plan_issue_surface": "advisory",
    "gsw_plan_quality_checks": true,
    "gsw_plan_request_contract": true,
    "gsw_plan_update_guard": "enforce",
    "gsw_plan_verifier": true,
    "gsw_planner_tool": true,
    "gsw_qualifier_grounding_policy": "lenient",
    "gsw_react_fallback": true,
    "gsw_read_is_reader": true,
    "gsw_read_promotion": true,
    "gsw_read_raw_fallback": true,
    "gsw_recovery": "false",
    "gsw_recovery_max_overwrites": 1,
    "gsw_recovery_max_redispatch": 1,
    "gsw_researcher_stateful": false,
    "gsw_rival_scan": false,
    "gsw_search_dedup": false,
    "gsw_typed_blank_resolver": true,
    "gsw_verifier_cap_policy": "accept_with_flag",
    "gsw_verifier_max_retries": 2,
    "gsw_verifier_reasoning": true,
    "gsw_verifier_scoped": true,
    "llm_seed": 42,
    "llm_temperature": 0.0,
    "max_completion_tokens": 16384,
    "max_prompt_tokens": 32000,
    "max_turns": 50,
    "orchestrator_mode": "llm",
    "reasoning_effort": "medium",
    "reranker": "jina",
    "retriever_type": "hybrid",
    "synthesis_validator_mode": "repair"
  },
  "dataset_keys": [
    "corpus",
    "dense_cache",
    "lucene_index"
  ],
  "inert_keys": {
    "_about": "present in the recorded config but not read on the live path (kept for identity with the record)",
    "keys": [
      "gsw_verifier_max_retries",
      "gsw_verifier_cap_policy",
      "gsw_qualifier_grounding_policy",
      "gsw_grounding_strict_tries",
      "gsw_recovery_max_overwrites",
      "gsw_recovery_max_redispatch",
      "gsw_champion",
      "max_prompt_tokens",
      "max_turns"
    ]
  },
  "pinned_adapter_defaults": {
    "level_max_turns": 20,
    "orchestrator_max_turns": 12,
    "MAX_PLANNER_TOOL_CALLS": 3,
    "MAX_PLAN_UPDATES_PER_RUN": 5,
    "MAX_PARALLEL_RESEARCHERS": 8,
    "MAX_ESCALATIONS_PER_BLANK": 2,
    "MAX_VALIDATOR_RETRIES": 1,
    "MAX_VALIDATOR_GUIDED_REPAIRS_PER_RUN": 1,
    "synthesis_validator_guided_repair": true,
    "search_top_k_default": 5,
    "rerank_candidate_k": 40,
    "rrf_k": 60,
    "rrf_per_retriever_top_k": 50,
    "reader_max_turns": 8,
    "reader_model_context_tokens": 65536,
    "raw_read_window_chars": 12000,
    "invmem_R_Q": 5,
    "invmem_R_STALL": 5,
    "invmem_K_DRY": 15,
    "plan_updater_max_revision_attempts": 3
  },
  "serving": {
    "llm": "gpt-oss-120b on vLLM 0.24 (OpenAI-compatible), tensor-parallel 2, --max-model-len 65536, --tool-call-parser openai --enable-auto-tool-choice (serve/gpt_oss_120b.sh)",
    "reranker": "jinaai/jina-reranker-v3.5 on vLLM, served as 'jina-rerank' (serve/jina_reranker.sh)",
    "query_encoder": "Qwen/Qwen3-Embedding-8B (sentence-transformers, fp16, local GPU)"
  }
}
